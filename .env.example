# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional, only needed for the E2B cloud sandbox backend.
# E2B_API_KEY=e2b_your-key-here

# Optional, only for labs that say "download the dataset from Kaggle".
# Kaggle > Settings > API > Create New Token gives you a kaggle.json holding
# both values. Without them, a Kaggle reference fails with a message telling
# you this -- the run continues and the other tasks still get solved.
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key

# --- hosting (only when it is served to someone other than you) ---------------
# Sign-in. Set BOTH and the app shows a sign-in page and refuses every API call
# until it gets them; leave either empty and there is no sign-in at all, which
# is what you want on localhost. Use a long random password -- it is the only
# thing between the internet and your DeepSeek balance:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# LABSAGENT_USER=reviewer
# LABSAGENT_PASSWORD=

# Read by compose.yaml for Caddy (HTTPS). The server's public hostname: with no
# domain, the static IP written with dashes plus .sslip.io, e.g. for 13.50.1.2:
# SITE_ADDRESS=13-50-1-2.sslip.io
# Where certificate notices go, and the account for Caddy's ZeroSSL fallback.
# ACME_EMAIL=you@example.com
