# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here

# Optional, only needed for the E2B cloud sandbox backend.
# E2B_API_KEY=e2b_your-key-here

# Optional, only for labs that say "download the dataset from Kaggle".
# Kaggle > Settings > API > Create New Token gives you a kaggle.json holding
# both values. Without them, a Kaggle reference fails with a message telling
# you this -- the run continues and the other tasks still get solved.
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=your-kaggle-api-key
