# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- internal / not for publication ------------------------------------------
# Working plan, roadmap and internal status notes. Local only.
PLAN.md
INTERNAL.md

# The product record written by `/impeccable init`. Same reason as PLAN.md, plus
# one of its own: it states that real submissions from this tool have been
# handed in and graded, and it restates the institution's constraints. That is
# context for design work on this machine, not something to publish beside the
# code.
PRODUCT.md

# Deep-dive write-ups about how this project works, written to learn from rather
# than to ship. They quote internals freely and go stale as the code moves, so
# they are local notes, not documentation anyone else should find.
Learning/

# Course material: the institution's, often carries identifying details.
labs/

# Student identity (name, CMS/roll number) written by the first interactive run.
labsagent.toml

# Word documents anywhere. The test fixture is generated by
# tests/fixtures/make_manual.py, so it never needs committing.
*.docx
~$*.docx

# --- generated output ---------------------------------------------------------
build/
runs/

# Launch video built by `/brag`: the render, its poster, and the Hyperframes
# composition source that produces them -- which carries its own node_modules.
brag-output/

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
dist/
*.egg-info/
.eggs/

# --- tooling ------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- editors / os -------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- generated test inputs and their results ----------------------------------
# `web/fixtures/make_inputs.py` rebuilds these on demand, and `*.docx` above
# already excludes one of them -- keeping the rest would be half a fixture set.
web/fixtures/inputs/
web/fixtures/matrix_out/

# Docs stay local -- only the README is published
*.md
!/README.md
.impeccable/
